#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoload)) {
	fwrite(STDERR, "Composer dependencies are missing.\n");
	fwrite(STDERR, "Run `cd backend && docker-compose up -d` and then `docker-compose exec php ./bin/migrate`.\n");
	fwrite(STDERR, "If you want to run migrations on the host, install dependencies first with `cd backend/app && composer install`.\n");
	exit(1);
}
require $autoload;

if (class_exists(\Dotenv\Dotenv::class)) {
	$dotenv = \Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
	$dotenv->safeLoad();
}

use App\Utils\Database;
use App\Utils\SchemaManager;

try {
	$pdo = Database::getConnection();
	SchemaManager::ensure($pdo);
	fwrite(STDOUT, "Migrations executed successfully.\n");
	exit(0);
} catch (\Throwable $e) {
	fwrite(STDERR, "Migration failed: " . $e->getMessage() . "\n");
	exit(1);
}
